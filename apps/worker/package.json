{
  "name": "@atlas/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/outbox-worker.js",
  "types": "dist/outbox-worker.d.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --pool=threads && node scripts/verify-web-browser.mjs",
    "test:browser": "node scripts/verify-web-browser.mjs"
  },
  "dependencies": {
    "@atlas/catalog": "workspace:*",
    "@playwright/test": "1.54.1",
    "@aws-sdk/client-s3": "3.850.0",
    "@atlas/config": "workspace:*",
    "@atlas/database": "workspace:*",
    "@atlas/observability": "workspace:*",
    "bullmq": "5.56.8",
    "ioredis": "5.6.1",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@types/node": "22.16.4",
    "tsx": "4.20.3",
    "vitest": "3.2.4"
  }
}
